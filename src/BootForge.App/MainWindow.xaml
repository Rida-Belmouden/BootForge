<Window x:Class="BootForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BootForge"
        Width="720"
        Height="700"
        MinWidth="620"
        MinHeight="620"
        Background="#F7F8FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="BootForge"
                       FontSize="30"
                       FontWeight="SemiBold" />

            <StackPanel Margin="0,6,0,0"
                        Orientation="Horizontal">
                <TextBlock Text="Bootable USB creation utility"
                           FontSize="14"
                           Opacity="0.65" />

                <TextBlock Margin="8,0,0,0"
                           Text="{Binding VersionText}"
                           FontSize="14"
                           Opacity="0.5" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Height="38"
                      Padding="10,4"
                      IsEnabled="{Binding CanModifySelection}"
                      ItemsSource="{Binding Disks}"
                      SelectedItem="{Binding SelectedDisk}"
                      DisplayMemberPath="DisplayName" />

            <Button Grid.Column="2"
                    MinWidth="100"
                    Height="38"
                    Padding="16,4"
                    Content="Refresh"
                    IsEnabled="{Binding CanModifySelection}"
                    Command="{Binding RefreshDisksCommand}" />
        </Grid>

        <Border Grid.Row="4"
                Padding="16"
                Background="White"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Boot selection"
                               FontWeight="SemiBold" />

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding SelectedImageName}" />

                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding SelectedImageDetails}"
                               Opacity="0.65" />
                </StackPanel>

                <Button Grid.Column="2"
                        MinWidth="110"
                        Height="38"
                        Padding="16,4"
                        VerticalAlignment="Top"
                        Content="Select image"
                        IsEnabled="{Binding CanModifySelection}"
                        Command="{Binding SelectImageCommand}" />

                <Border Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Margin="0,12,0,0"
                        Padding="12"
                        Background="#F7F8FA"
                        CornerRadius="6"
                        Visibility="{Binding HasSelectedImage,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Boot compatibility"
                                       FontWeight="SemiBold" />

                            <TextBlock Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       Text="Raw mode preserves the image layout."
                                       FontSize="12"
                                       Opacity="0.6" />
                        </Grid>

                        <UniformGrid Margin="0,10,0,0"
                                     Columns="5">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Firmware"
                                           FontSize="12"
                                           Opacity="0.6" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedImageFirmware}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Image layout"
                                           FontSize="12"
                                           Opacity="0.6" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedImageLayout}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Partition scheme"
                                           FontSize="12"
                                           Opacity="0.6" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedImagePartitionScheme}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="File system"
                                           FontSize="12"
                                           Opacity="0.6" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedImageFileSystem}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Write method"
                                           FontSize="12"
                                           Opacity="0.6" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SelectedImageWriteMode}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="6"
                Padding="20"
                Background="White"
                BorderBrush="#D0D5DD"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Selected physical disk"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <UniformGrid Grid.Row="2"
                             Columns="3">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Device path"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.DevicePath,
                                                  TargetNullValue=—}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Vendor"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.Vendor,
                                                  TargetNullValue=—}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Product"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.Product,
                                                  TargetNullValue=—}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Grid.Row="4"
                             Columns="3">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Serial number"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.SerialNumber,
                                                  TargetNullValue=—}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Bus type"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.BusType,
                                                  TargetNullValue=—}"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Capacity"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.FormattedSize,
                                                  TargetNullValue=—}"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </UniformGrid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Safety status"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.Safety.Status,
                                                  TargetNullValue=Unknown}"
                                   FontWeight="SemiBold" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Safety assessment"
                                   FontSize="12"
                                   Opacity="0.6" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding SelectedDisk.Safety.Reason,
                                                  TargetNullValue=—}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}"
                           Opacity="0.7" />

                <TextBlock Margin="0,3,0,0"
                           Text="{Binding StartHint}"
                           FontWeight="SemiBold" />

                <ProgressBar Margin="0,8,16,0"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding WriteProgress}"
                             Visibility="{Binding IsWriting,
                                Converter={StaticResource BooleanToVisibilityConverter}}" />

                <TextBlock Margin="0,4,16,0"
                           Text="{Binding WriteProgressText}"
                           Opacity="0.7"
                           Visibility="{Binding IsWriting,
                              Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <Button MinWidth="100"
                        Height="38"
                        Content="Start"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}" />

                <Button Margin="12,0,0,0"
                        MinWidth="100"
                        Height="38"
                        Content="Eject"
                        Command="{Binding EjectTargetCommand}"
                        IsEnabled="{Binding CanEject}"
                        Visibility="{Binding HasCompletedWrite,
                           Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Button Margin="12,0,0,0"
                        MinWidth="100"
                        Height="38"
                        Content="Cancel"
                        Command="{Binding CancelWriteCommand}"
                        Visibility="{Binding IsWriting,
                           Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

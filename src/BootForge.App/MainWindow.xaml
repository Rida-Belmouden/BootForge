<Window x:Class="BootForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BootForge"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="450"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="BootForge"
                       FontSize="30"
                       FontWeight="SemiBold" />

            <TextBlock Margin="0,6,0,0"
                       Text="Bootable USB creation utility"
                       FontSize="14"
                       Opacity="0.65" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      Height="38"
                      Padding="10,4"
                      ItemsSource="{Binding Disks}"
                      SelectedItem="{Binding SelectedDisk}"
                      DisplayMemberPath="DisplayName" />

            <Button Grid.Column="2"
                    MinWidth="100"
                    Height="38"
                    Padding="16,4"
                    Content="Refresh"
                    Command="{Binding RefreshDisksCommand}" />
        </Grid>

        <Border Grid.Row="4"
                Padding="20"
                BorderThickness="1"
                CornerRadius="8">

            <StackPanel>
                <TextBlock Text="Selected physical disk"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,16" />

                <TextBlock Text="Device path"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding SelectedDisk.DevicePath, TargetNullValue=—}"
                           Margin="0,4,0,12" />

                <TextBlock Text="Vendor"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding SelectedDisk.Vendor, TargetNullValue=—}"
                           Margin="0,4,0,12" />

                <TextBlock Text="Product"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding SelectedDisk.Product, TargetNullValue=—}"
                           Margin="0,4,0,12" />

                <TextBlock Text="Serial number"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding SelectedDisk.SerialNumber, TargetNullValue=—}"
                           Margin="0,4,0,12" />

                <TextBlock Text="Bus type" 
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding SelectedDisk.BusType, TargetNullValue=—}"
                           Margin="0,4,0,12" />

                <TextBlock Text="Capacity"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding SelectedDisk.FormattedSize, TargetNullValue=—}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       Opacity="0.7" />

            <Button Grid.Column="1"
                    MinWidth="100"
                    Height="38"
                    Content="Start"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</Window>